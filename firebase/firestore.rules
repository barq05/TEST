rules_version = '2';

// ============================================================
//  AURABOT — Firestore Security Rules
//  الصلاحيات كلها بتتفرض هنا على سيرفر Google، مش في الـ frontend.
//  الصقها في: Firebase Console > Firestore Database > Rules > Publish
//
//  مستويات الصلاحية (level) لكل قسم: 0 = ممنوع، 1 = عرض، 2 = إدارة.
//  لو عايز تغيّر صلاحيات الأدوار الأساسية عدّل الدالة builtinPerms()
//  (ولازم تعدّل نفس المصفوفة PERMS في admin/index.html عشان الواجهة تطابق).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // ثوابت
    // ---------------------------------------------------------
    function founderEmail() { return 'barqelhadidy@gmail.com'; }   // المالك الرئيسي الدائم
    function builtinRoles() { return ['receiver', 'admin', 'owner', 'mainowner']; }
    function builtinRank()  { return {'receiver': 1, 'admin': 2, 'owner': 3, 'mainowner': 4}; }
    function builtinPerms() {
      return {
        'receiver':  {'overview': 1, 'orders': 2, 'tickets': 2},
        'admin':     {'overview': 1, 'orders': 2, 'tickets': 2, 'products': 2, 'team': 2},
        'owner':     {'overview': 1, 'orders': 2, 'tickets': 2, 'products': 2, 'team': 2, 'discounts': 2},
        'mainowner': {'overview': 2, 'orders': 2, 'tickets': 2, 'products': 2, 'team': 2, 'discounts': 2, 'payments': 2, 'roles': 2}
      };
    }

    // ---------------------------------------------------------
    // الهوية والأدوار
    // ---------------------------------------------------------
    function teamPath(e) { return /databases/$(database)/documents/team/$(e); }
    function rolePath(r) { return /databases/$(database)/documents/roles/$(r); }

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function isFounder() { return signedIn() && myEmail() == founderEmail(); }
    function isTeam() { return signedIn() && (isFounder() || exists(teamPath(myEmail()))); }
    function myRole() {
      return isFounder() ? 'mainowner' : get(teamPath(myEmail())).data.role;
    }
    function rankOfRole(r) {
      return r in builtinRoles() ? builtinRank()[r] : get(rolePath(r)).data.rank;
    }
    // 0 = مش في الفريق، 4 = مالك رئيسي، 5 = المالك الرئيسي الدائم
    function myRank() {
      return !isTeam() ? 0 : (isFounder() ? 5 : rankOfRole(myRole()));
    }
    // مستوى صلاحية القسم: 0 ممنوع، 1 عرض، 2 إدارة
    function level(section) {
      return !isTeam() ? 0
        : (isFounder() ? 2
          : (myRole() in builtinRoles()
              ? builtinPerms()[myRole()].get(section, 0)
              : get(rolePath(myRole())).data.perms.get(section, 0)));
    }

    // ---------------------------------------------------------
    // حساب الخصومات (لازم يطابق الحساب في الموقع)
    // ---------------------------------------------------------
    function productDisc(p) {
      return p.discountType == 'fixed' ? (p.discountValue > p.price ? p.price : p.discountValue)
           : (p.discountType == 'percent' ? math.floor(p.price * p.discountValue / 100.0) : 0);
    }
    function codeDisc(c, base) {
      return c.type == 'fixed' ? (c.value > base ? base : c.value)
           : math.floor(base * c.value / 100.0);
    }

    // ---------------------------------------------------------
    // التحقق من البيانات
    // ---------------------------------------------------------
    function orderKeys() {
      return ['uid', 'email', 'customerName', 'discord', 'notes', 'productId', 'productName',
              'unitPrice', 'productDiscount', 'codeUsed', 'codeDiscount', 'total', 'gift',
              'status', 'createdAt', 'updatedAt'];
    }

    function codeOk(d, base) {
      let cp = /databases/$(database)/documents/discountCodes/$(d.codeUsed);
      let c = get(cp).data;
      return d.codeUsed.matches('^[A-Z0-9_-]{2,24}$')
        && c.active == true
        && (c.expiresAt == null || c.expiresAt > request.time)
        && (c.maxUses == null || c.usedCount < c.maxUses)
        && (c.minOrder == null || base >= c.minOrder)
        && (c.productId == null || c.productId == d.productId)
        && d.codeDiscount == codeDisc(c, base)
        && d.total == base - d.codeDiscount
        && getAfter(cp).data.usedCount == c.usedCount + 1;
    }

    function validOrderCreate() {
      let d = request.resource.data;
      let p = get(/databases/$(database)/documents/products/$(d.productId)).data;
      let base = p.price - productDisc(p);
      return d.keys().hasOnly(orderKeys())
        && d.keys().hasAll(orderKeys())
        && d.uid == request.auth.uid
        && d.email == request.auth.token.email
        && d.customerName is string && d.customerName.size() >= 2 && d.customerName.size() <= 60
        && d.discord is string && d.discord.size() >= 2 && d.discord.size() <= 40
        && d.notes is string && d.notes.size() <= 500
        && d.productId is string
        && p.active == true
        && d.productName == p.name
        && d.unitPrice == p.price
        && d.productDiscount == productDisc(p)
        && d.gift == p.gift
        && d.status == 'new'
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && (d.codeUsed == ''
              ? (d.codeDiscount == 0 && d.total == base)
              : codeOk(d, base));
    }

    function validProduct() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'price', 'description', 'details', 'discountType', 'discountValue',
                               'gift', 'featured', 'active', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'price', 'description', 'details', 'discountType', 'discountValue',
                            'gift', 'featured', 'active'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.price is int && d.price >= 0 && d.price <= 10000000
        && d.description is string && d.description.size() <= 4000
        && d.details is string && d.details.size() <= 8000
        && d.discountType in ['none', 'fixed', 'percent']
        && d.discountValue is int && d.discountValue >= 0
        && (d.discountType != 'percent' || d.discountValue <= 100)
        && (d.discountType != 'fixed' || d.discountValue <= d.price)
        && d.gift is string && d.gift.size() <= 120
        && d.featured is bool
        && d.active is bool;
    }

    function validCode(code) {
      let d = request.resource.data;
      return code.matches('^[A-Z0-9_-]{2,24}$')
        && d.keys().hasOnly(['code', 'type', 'value', 'expiresAt', 'maxUses', 'usedCount', 'minOrder',
                             'productId', 'active', 'createdAt', 'lastOrderId'])
        && d.keys().hasAll(['code', 'type', 'value', 'expiresAt', 'maxUses', 'usedCount', 'minOrder',
                            'productId', 'active'])
        && d.code == code
        && d.type in ['fixed', 'percent']
        && d.value is int && d.value > 0
        && (d.type != 'percent' || d.value <= 100)
        && (d.expiresAt == null || d.expiresAt is timestamp)
        && (d.maxUses == null || (d.maxUses is int && d.maxUses > 0))
        && d.usedCount is int && d.usedCount >= 0
        && (d.minOrder == null || (d.minOrder is int && d.minOrder >= 0))
        && (d.productId == null || d.productId is string)
        && d.active is bool;
    }

    // العميل مسموحله يزوّد usedCount بواحد بس، ومع إنشاء طلب جديد بنفس الـ batch
    function customerUse(code) {
      let r = request.resource.data;
      let o = resource.data;
      let op = /databases/$(database)/documents/orders/$(r.lastOrderId);
      return signedIn()
        && r.diff(o).affectedKeys().hasOnly(['usedCount', 'lastOrderId'])
        && r.usedCount == o.usedCount + 1
        && r.lastOrderId is string
        && existsAfter(op) && !exists(op)
        && getAfter(op).data.codeUsed == code
        && getAfter(op).data.uid == request.auth.uid;
    }

    function validPayment() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'details', 'instructions', 'active', 'order', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'details', 'instructions', 'active', 'order'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.details is string && d.details.size() <= 1000
        && d.instructions is string && d.instructions.size() <= 3000
        && d.active is bool
        && d.order is int;
    }

    function validMember(e) {
      let d = request.resource.data;
      return e == e.lower()
        && e.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && d.keys().hasOnly(['email', 'name', 'role', 'addedBy', 'addedAt'])
        && d.keys().hasAll(['email', 'role', 'addedBy', 'addedAt'])
        && d.email == e
        && (!('name' in d) || (d.name is string && d.name.size() <= 60))
        && d.role is string && d.role.size() <= 30
        && (d.role in builtinRoles() || exists(rolePath(d.role)))
        && d.addedBy == myEmail()
        && d.addedAt == request.time;
    }

    function validRole(id) {
      let d = request.resource.data;
      return id.matches('^[a-z0-9_-]{2,30}$')
        && !(id in builtinRoles())
        && d.keys().hasOnly(['name', 'rank', 'perms', 'createdAt'])
        && d.keys().hasAll(['name', 'rank', 'perms'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.rank is int && d.rank >= 1 && d.rank <= 3
        && d.perms is map
        // الأدوار المخصصة مفيهاش payments ولا roles (حصريين للمالك الرئيسي)
        && d.perms.keys().hasOnly(['overview', 'orders', 'tickets', 'products', 'discounts', 'team'])
        && d.perms.get('overview', 0) in [1, 2]
        && d.perms.get('orders', 0) in [1, 2]
        && d.perms.get('tickets', 0) in [0, 1, 2]
        && d.perms.get('products', 0) in [0, 1, 2]
        && d.perms.get('discounts', 0) in [0, 1, 2]
        && d.perms.get('team', 0) in [0, 1, 2]
        // نفس تدرّج الأدوار الأساسية: المنتجات والفريق من Admin (2) وفوق، والخصومات من Owner (3) وفوق
        && (d.perms.get('products', 0) == 0 || d.rank >= 2)
        && (d.perms.get('team', 0) == 0 || d.rank >= 2)
        && (d.perms.get('discounts', 0) == 0 || d.rank >= 3);
    }

    function validMsg() {
      let d = request.resource.data;
      return d.keys().hasOnly(['from', 'uid', 'text', 'createdAt'])
        && d.keys().hasAll(['from', 'uid', 'text', 'createdAt'])
        && d.from in ['customer', 'team']
        && d.uid == request.auth.uid
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 1000
        && d.createdAt == request.time;
    }

    // ---------------------------------------------------------
    // الفريق
    // ---------------------------------------------------------
    match /team/{memberEmail} {
      // أي مستخدم مسجّل يقرا مستند نفسه بس (عشان يتأكد من صلاحيته)
      allow get: if signedIn() && (memberEmail == myEmail() || level('team') >= 1);
      allow list: if level('team') >= 1;
      // Admin وفوق يضيفوا عضو بدور أقل من دورهم. المالك الرئيسي يضيف أي دور.
      allow create: if level('team') >= 2
        && validMember(memberEmail)
        && (myRank() >= 4 || rankOfRole(request.resource.data.role) < myRank());
      // تعديل الدور والحذف: المالك الرئيسي فقط. والمالك الدائم محمي من الحذف.
      allow update: if myRank() >= 4
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'name'])
        && request.resource.data.role is string
        && (request.resource.data.role in builtinRoles() || exists(rolePath(request.resource.data.role)));
      allow delete: if myRank() >= 4 && memberEmail != founderEmail();
    }

    // الأدوار المخصصة (إنشاء/تعديل/حذف: المالك الرئيسي فقط)
    match /roles/{roleId} {
      allow read: if isTeam();
      allow create, update: if myRank() >= 4 && validRole(roleId);
      allow delete: if myRank() >= 4;
    }

    // ---------------------------------------------------------
    // المنتجات (قراءة عامة للموقع، إدارة: Admin وفوق)
    // ---------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow create, update: if level('products') >= 2 && validProduct();
      allow delete: if level('products') >= 2;
    }

    // ---------------------------------------------------------
    // أكواد الخصم (عرض وإدارة: Owner وفوق)
    // العميل يقدر يقرا كود واحد بالاسم (get) علشان يشوف الخصم، ومش يعمل list.
    // ---------------------------------------------------------
    match /discountCodes/{code} {
      allow get: if signedIn();
      allow list: if level('discounts') >= 1;
      allow create: if level('discounts') >= 2 && validCode(code);
      allow update: if (level('discounts') >= 2 && validCode(code)) || customerUse(code);
      allow delete: if level('discounts') >= 2;
    }

    // ---------------------------------------------------------
    // طرق الدفع: الإدارة للمالك الرئيسي فقط (قسم في الـ Dashboard).
    // القراءة عامة لأن العميل لازم يشوف طرق الدفع وتعليماتها عشان يحوّل.
    // ---------------------------------------------------------
    match /paymentMethods/{methodId} {
      allow read: if true;
      allow create, update: if level('payments') >= 2 && validPayment();
      allow delete: if level('payments') >= 2;
    }

    // ---------------------------------------------------------
    // الطلبات
    // ---------------------------------------------------------
    match /orders/{orderId} {
      // العميل يشوف طلباته بس. أي عضو فريق يشوف كل الطلبات.
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || level('orders') >= 1);
      allow create: if signedIn() && validOrderCreate();
      // تغيير الحالة بس
      allow update: if level('orders') >= 2
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'paid', 'delivered', 'cancelled']
        && request.resource.data.updatedAt == request.time;
      // الحذف النهائي: المالك الرئيسي فقط
      allow delete: if myRank() >= 4;

      match /messages/{messageId} {
        function orderOwner() {
          return get(/databases/$(database)/documents/orders/$(orderId)).data.uid == request.auth.uid;
        }
        allow read: if signedIn() && (orderOwner() || level('orders') >= 1);
        allow create: if signedIn() && validMsg()
          && ((request.resource.data.from == 'customer' && orderOwner())
              || (request.resource.data.from == 'team' && level('orders') >= 2));
        allow delete: if myRank() >= 4;
      }
    }

    // ---------------------------------------------------------
    // التذاكر
    // ---------------------------------------------------------
    match /tickets/{ticketId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || level('tickets') >= 1);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'type', 'title', 'body', 'status', 'createdAt', 'lastReplyAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'type', 'title', 'body', 'status', 'createdAt', 'lastReplyAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.type in ['support', 'complaint', 'inquiry']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 5 && request.resource.data.body.size() <= 2000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastReplyAt == request.time;
      allow update: if level('tickets') >= 2
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastReplyAt'])
        && request.resource.data.status in ['new', 'open', 'closed'];
      // الحذف النهائي: المالك الرئيسي فقط
      allow delete: if myRank() >= 4;

      match /messages/{messageId} {
        function ticketOwner() {
          return get(/databases/$(database)/documents/tickets/$(ticketId)).data.uid == request.auth.uid;
        }
        allow read: if signedIn() && (ticketOwner() || level('tickets') >= 1);
        allow create: if signedIn() && validMsg()
          && ((request.resource.data.from == 'customer' && ticketOwner())
              || (request.resource.data.from == 'team' && level('tickets') >= 2));
        allow delete: if myRank() >= 4;
      }
    }

    // ---------------------------------------------------------
    // الزيارات (لحساب معدل التحويل): أي زائر يسجّل زيارة واحدة في اليوم، والإنشاء بس
    // ---------------------------------------------------------
    match /visits/{visitId} {
      allow create: if visitId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[A-Za-z0-9]{8,40}$')
        && request.resource.data.keys().hasOnly(['d', 't'])
        && request.resource.data.d == visitId.split('_')[0]
        && request.resource.data.t == request.time;
      allow read: if level('overview') >= 1;
    }

    // أي حاجة تانية ممنوعة افتراضيًا.
  }
}
